{
  "rules": {
    ".read": false,
    ".write": false,

    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['uid','email','role','status']) && (newData.child('role').val() == 'diretor' || newData.child('role').val() == 'professor' || newData.child('role').val() == 'responsavel' || newData.child('role').val() == 'pai' || newData.child('role').val() == 'admin') && (newData.child('status').val() == 'ativo' || newData.child('status').val() == 'pendente' || newData.child('status').val() == 'desativado')"
      }
    },

    "cadastrosPendentes": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "!data.exists() && auth != null && auth.uid == $uid",
        ".validate": "(!newData.exists()) || (!newData.child('status').exists() || newData.child('status').val() == 'pendente')"
      }
    },

    "alunos": {
      "$alunoId": {
        ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'professor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin' || root.child('usuarios').child(auth.uid).child('alunosVinculados').child($alunoId).val() == true || !root.child('usuarios').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')",
        ".validate": "newData.hasChildren(['nome'])"
      },
      ".indexOn": ["turmaId"]
    },

    "entregas": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "avisos": {
      ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin' || root.child('usuarios').child(auth.uid).child('role').val() == 'professor')",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
    },

    "professores": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
      }
    },

    "pais": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
      }
    },

    "turmas": {
      "$tid": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
      }
    },

    "disciplinas": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
    },

    "horarios": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
    },

    "chamadas": {
      ".indexOn": ["professorId"],
      "$turmaId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'professor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
      }
    },

    "notas": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'professor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
    },

    "bilhetes": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["professorId"]
    },

    "boletos": {
      "$alunoId": {
        ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin' || root.child('usuarios').child(auth.uid).child('alunosVinculados').child($alunoId).val() == true)",
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
      }
    },

    "logs": {
      ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')",
      ".write": false
    },

    "agregados": {
      ".read": "auth != null",
      ".write": false
    },

    "escola": {
      "info": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
      }
    },

    "convites": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
    },

    "metrics": {
      ".read": "auth != null",
      ".write": false
    },

    "frequencia": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() == 'diretor' || root.child('usuarios').child(auth.uid).child('role').val() == 'professor' || root.child('usuarios').child(auth.uid).child('role').val() == 'admin')"
    },

    "profile_photos": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
