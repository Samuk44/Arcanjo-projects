{
  "rules":{
    "entregas":{
      "$uid":{
        ".read":"auth != null && auth.uid === $uid",
        ".write":"auth != null && auth.uid === $uid",
        ".validate":"newData.hasChildren(['titulo','conteudo','destinos','criadoEm']) && newData.child('titulo').isString() && newData.child('conteudo').isString() && (newData.child('destinos').isString() || newData.child('destinos').isArray()) && newData.child('criadoEm').isNumber()"
      }
    },
    "avisos":{
      ".read":"auth != null && (root.child('roles').child(auth.uid).val() === 'diretor' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'professor')",
      ".write":"auth != null && (root.child('roles').child(auth.uid).val() === 'diretor' || root.child('roles').child(auth.uid).val() === 'admin')",
      "$aid":{
        ".validate":"newData.hasChildren(['titulo','conteudo','destinos','criadoEm']) && newData.child('titulo').isString() && newData.child('conteudo').isString() && (newData.child('destinos').isString() || newData.child('destinos').isArray()) && newData.child('criadoEm').isNumber()"
      }
    }
  }
}